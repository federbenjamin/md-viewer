        "MDViewer (iOS)/resources",
        "MDViewer (macOS)/resources",
      ],
    }, {
      "path": "../PRIVACY.md",
      "target-membership": [
        "MDViewer (iOS)/resources",
        "MDViewer (macOS)/resources",
      ],
    }, {
      "kind": "group",
