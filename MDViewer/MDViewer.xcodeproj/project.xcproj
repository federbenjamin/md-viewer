        { "path": "WelcomeView.swift", "target-membership": [ "MDViewer (iOS)/compile-sources", "MDViewer (macOS)/compile-sources" ] },
        { "path": "SetupView.swift", "target-membership": [ "MDViewer (iOS)/compile-sources", "MDViewer (macOS)/compile-sources" ] },
        { "path": "BundledMarkdownView.swift", "target-membership": [ "MDViewer (iOS)/compile-sources", "MDViewer (macOS)/compile-sources" ] },
      ],
    }, {
