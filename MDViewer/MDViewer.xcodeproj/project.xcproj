      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MDViewer.app", "id": "D98F3C0C30A2437000F5A365", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MDViewer.app", "id": "D98F3C1E30A2437000F5A365", "type": "wrapper.application", "index": false },
