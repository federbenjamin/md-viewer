      "children": [
        {
          "path": "Assets.xcassets",
          "target-membership": [
            "MDViewer (iOS)/resources",
            "MDViewer (macOS)/resources",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Shared (Extension)",
      "children": [
        {
          "kind": "group",
          "path": "<PROJECT>/Shared (Extension)",
          "name": "Resources",
          "children": [
            {
              "path": "../../web/manifest.json",
              "target-membership": [
                "MDViewer (iOS)/resources",
                "MDViewer (macOS)/resources",
                "MDViewer Extension (iOS)/resources",
                "MDViewer Extension (macOS)/resources",
              ],
            }, {
              "path": "../../web/content.js",
              "target-membership": [
                "MDViewer Extension (iOS)/resources",
                "MDViewer Extension (macOS)/resources",
              ],
            }, {
              "path": "../../web/background.js",
              "target-membership": [
                "MDViewer Extension (iOS)/resources",
                "MDViewer Extension (macOS)/resources",
              ],
            }, {
              "path": "../../web/viewer",
              "target-membership": [
                "MDViewer (iOS)/resources",
                "MDViewer (macOS)/resources",
                "MDViewer Extension (iOS)/resources",
                "MDViewer Extension (macOS)/resources",
              ],
            }, {
              "path": "../../web/lib",
              "target-membership": [
                "MDViewer (iOS)/resources",
                "MDViewer (macOS)/resources",
                "MDViewer Extension (iOS)/resources",
