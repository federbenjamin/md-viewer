        { "path": "<PRODUCTS>/MDViewer Extension.appex", "id": "D98F3C3430A2437000F5A365", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "MDViewer (macOS)/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
